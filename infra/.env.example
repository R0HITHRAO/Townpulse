# TownPulse — local stack environment (used by `docker compose -f infra/docker-compose.yml`)
# Copy this file to `infra/.env` and fill in values.
# `.env` is gitignored — your secrets never leave this machine.

# ─── OTP / SMS provider ────────────────────────────────────────────────────────
# mock   = no real SMS; the code is shown in the login UI and API response
# twilio = real SMS via Twilio (works with a free trial account)
# msg91  = real SMS via MSG91 (popular for Indian numbers)
OTP_PROVIDER=mock
OTP_EXPIRE_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=5

# Twilio (required when OTP_PROVIDER=twilio)
# Get these free at https://www.twilio.com/try-twilio → Console Dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # e.g. +15551234567 (your Twilio number)

# MSG91 (required when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TWNPUL
MSG91_TEMPLATE_ID=

# ─── Email provider (optional) ────────────────────────────────────────────────
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@townpulse.dev

# ─── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=townpulse-secret-key-for-local-dev-32-chars!
