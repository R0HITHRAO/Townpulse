# ============================================================
# TownPulse — Root Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# ─── General ────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
APP_NAME=TownPulse
APP_VERSION=0.1.0
DEBUG=true                         # Set to false in production

# ─── Backend ────────────────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (PostgreSQL + PostGIS) ────────────────────────
POSTGRES_SERVER=localhost           # Use 'postgres' inside Docker
POSTGRES_PORT=5432
POSTGRES_USER=townpulse
POSTGRES_PASSWORD=townpulse_dev_password
POSTGRES_DB=townpulse
DATABASE_URL=postgresql://townpulse:townpulse_dev_password@localhost:5432/townpulse

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost               # Use 'redis' inside Docker
REDIS_PORT=6379
REDIS_PASSWORD=                    # Leave empty for local dev
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ─── OTP / SMS Provider ─────────────────────────────────────
# Options: mock (local dev) | twilio (production)
OTP_PROVIDER=mock                  # Change to 'twilio' in production
OTP_EXPIRE_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=5       # Rate limit: 5 OTP requests per phone per hour

# Twilio (required only when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=                # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=                 # Your Twilio auth token
TWILIO_PHONE_NUMBER=               # +1234567890

# ─── Email Provider ──────────────────────────────────────────
# Options: mock (local dev) | sendgrid | smtp (production)
EMAIL_PROVIDER=mock                # Change to 'sendgrid' or 'smtp' in production
EMAIL_FROM=noreply@townpulse.dev
EMAIL_FROM_NAME=TownPulse

# SendGrid (required only when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=                  # SG.xxxxxxxxxxxxx

# SMTP (required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000  # Backend API URL for frontend

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── File Storage ────────────────────────────────────────────
# Options: local | s3
STORAGE_PROVIDER=local             # Change to 's3' for production
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (required only when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ─── Monitoring & Observability ──────────────────────────────
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus metrics (enabled by default)
METRICS_ENABLED=true

# ─── Maps ────────────────────────────────────────────────────
# Default map center (pilot town coordinates)
DEFAULT_MAP_LAT=12.9716           # Bangalore, India (change to your town)
DEFAULT_MAP_LNG=77.5946
DEFAULT_MAP_ZOOM=12

# Nominatim for address autocomplete (no API key required)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=100            # Requests per window
RATE_LIMIT_WINDOW=60               # Window in seconds

# ─── Admin ───────────────────────────────────────────────────
# Default admin credentials (CHANGE IN PRODUCTION)
ADMIN_EMAIL=admin@townpulse.dev
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=TownPulse Admin
