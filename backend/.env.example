# ============================================================
# TownPulse Backend — Environment Variables
# ============================================================
# Copy to .env and fill in your values.
# ============================================================

# Application
APP_ENV=development
APP_NAME=TownPulse
APP_VERSION=0.1.0
DEBUG=true

# Security
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=townpulse
POSTGRES_PASSWORD=townpulse_dev_password
POSTGRES_DB=townpulse
DATABASE_URL=postgresql://townpulse:townpulse_dev_password@localhost:5432/townpulse

# Redis
REDIS_URL=redis://localhost:6379/0

# OTP
OTP_PROVIDER=mock
OTP_EXPIRE_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=5

# Twilio (used when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@townpulse.dev
EMAIL_FROM_NAME=TownPulse

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (used when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Monitoring
SENTRY_DSN=
METRICS_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
